{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berth-github-mirror",
  "main": "src/mirror/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "default"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "berth-push-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  }
}
